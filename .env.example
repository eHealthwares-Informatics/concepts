# Coding concepts service — environment contract (see src/ for reads).
# Copy to .env and fill in. Never commit real secrets.

# ── Core ────────────────────────────────────────────────────
PORT=8006
NODE_ENV=development
LOG_LEVEL=info

# ── Database (Postgres) ─────────────────────────────────────
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=9000
DB_USER=postgres
DB_PASSWORD=
DB_NAME=concepts
DB_SYNCHRONIZE=true
# Destructive: drops and recreates the schema on boot.
DB_DROP_SCHEMA=false

# ── Google Sheets import ────────────────────────────────────
# Service-account credentials; the three sheet ids select the source data.
GOOGLE_CLIENT_EMAIL=
# Newlines may be escaped as \n when held in a single env value.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
ICD_SHEET_ID=
FACILITY_SHEET_ID=

# ── Dev only ────────────────────────────────────────────────
SEED_ON_START=false
