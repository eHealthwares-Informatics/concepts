    "google-auth-library": "^10.6.2",
    "nest-commander": "^3.20.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typescript": "5.4.5"
  },
